# AssemblyAI key. SERVER-SIDE ONLY — never prefix it with a client-exposed name
# (no NEXT_PUBLIC_, no NG_APP_ that reaches the bundle).
ASSEMBLYAI_API_KEY=your_key_here

# Turns the cloud engines on at all. Accepts true / 1 / yes / on, case-insensitive.
ENABLE_ASSEMBLYAI=true

# Adds the Sync STT engine, the language picker, and the widened pause window.
# Matched case-sensitively: must be exactly the lowercase string `true`.
MULTI_LANGUAGE_SUPPORT=true

# Optional override for the Sync STT model (defaults to universal-3-5-pro).
# ASSEMBLYAI_SYNC_MODEL=universal-3-5-pro
